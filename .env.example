# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Cloud credentials for Google Docs integration
# Path to your Google Cloud service account credentials JSON file
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Google Drive folder ID where documents will be saved (optional)
# If not set, documents will be created in the root of Google Drive
GOOGLE_DRIVE_FOLDER_ID=

# Model configuration
CLAUDE_MODEL=claude-opus-4-5-20251101

# Web Search Configuration
# ========================
# Option 1: Use SerpAPI for reliable web searches (recommended)
# Get your API key from https://serpapi.com/ (100 free searches/month)
SERPAPI_KEY=

# Option 2: Disable web search entirely (AI fallback will be used)
# DISABLE_WEB_SEARCH=true

# Note: If SERPAPI_KEY is not set, the system will try DuckDuckGo
# which may be blocked by bot detection. AI fallback will be used
# if web search fails.

# Output directory for local files
OUTPUT_DIR=./output

# Logging level (debug, info, warn, error)
LOG_LEVEL=info
