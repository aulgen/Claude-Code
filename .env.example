# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Cloud credentials for Google Docs integration
# Path to your Google Cloud service account credentials JSON file
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Google Drive folder ID where documents will be saved (optional)
# If not set, documents will be created in the root of Google Drive
GOOGLE_DRIVE_FOLDER_ID=

# Model configuration
CLAUDE_MODEL=claude-sonnet-4-20250514

# Output directory for local files
OUTPUT_DIR=./output

# Logging level (debug, info, warn, error)
LOG_LEVEL=info
